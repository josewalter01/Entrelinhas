<article class="post<%= " short-story" if post.body.size <= 650 %>" id="<%= dom_id(post) %>" aria-labelledby="autor-<%= post.id %>">
  <div class="story-copy">
    <header class="byline">
      <%= render "shared/avatar", name: post.author_name, photo: post.author_photo_url %>
      <div>
        <h3 id="autor-<%= post.id %>"><%= post.author_name %></h3>
        <time datetime="<%= post.published_on.iso8601 %>"><%= l(post.published_on, format: :mural) %></time>
      </div>
    </header>
    <% first, gap, rest = post.body.partition(/\r?\n\r?\n/) %>
    <% unless gap.empty? %>
      <p class="<%= first.length <= 100 ? "lead" : "prose" %>"><%= first %></p>
      <p class="prose"><%= rest %></p>
    <% else %>
      <p class="prose"><%= post.body %></p>
    <% end %>
  </div>
  <% if post.attachment.attached? %>
    <% file = post.attachment.blob %>
    <% if file.image? %>
      <% image_path = rails_service_blob_path(file.signed_id, file.filename) %>
      <figure>
        <%= image_tag image_path, alt: "Imagem anexada por #{post.author_name}: #{file.filename.base.tr('_-', '  ')}", loading: "lazy" %>
        <figcaption><%= link_to image_path do %>Abrir imagem <%= icon("arrow-up-right") %><% end %></figcaption>
      </figure>
    <% else %>
      <%= link_to rails_service_blob_path(file.signed_id, file.filename, disposition: "attachment"), class: "file-link" do %>
        <%= icon("file-text") %><span><strong><%= file.filename %></strong><small>PDF · <%= (file.byte_size / 1024.0).ceil %> KiB</small></span><%= icon("download") %>
      <% end %>
    <% end %>
  <% end %>
  <div class="post-actions">
    <%= tag.iframe title: "Votos na publicação de #{post.author_name}", class: "vote-frame",
          srcdoc: String.new(render(partial: "posts/ballot", locals: { post: post, score: post.vote_score, current_vote: @my_votes[post.id] })) %>
    <% if signed_author && post.author_key == session[:suap_key] %>
      <details class="delete-post">
        <summary aria-label="Excluir publicação" title="Excluir publicação"><span aria-hidden="true">🗑️</span></summary>
        <%= button_to "Confirmar exclusão", post_path(post), method: :delete, params: { ordem: @order, tipo: @filter } %>
      </details>
    <% end %>
  </div>
</article>
